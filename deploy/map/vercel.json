{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/data.json", "destination": "https://frbsdcwab8vdcurw.public.blob.vercel-storage.com/map/data.json" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/sez/manifest.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
    { "source": "/sez/(\\d+)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
