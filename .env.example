# Copy to .env. Every value is optional.

# Port and host for the dashboard. Keep 127.0.0.1 unless you set SEATED_PASSWORD.
PORT=4310
HOST=127.0.0.1

# Where Seated keeps its SQLite file.
SEATED_DB=data/seated.db

# How often to check every watched restaurant, in seconds. Do not go below 60:
# the booking platforms are shared infrastructure.
POLL_SECONDS=120

# How many days ahead a watch looks when it has no end date.
HORIZON_DAYS=14

# Auto-book master switch. Off unless set to "true". Each watch must also opt in.
AUTOBOOK=false

# Protect the dashboard with HTTP basic auth (user "seated") when you host it.
SEATED_PASSWORD=
