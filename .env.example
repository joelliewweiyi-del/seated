# Copy to .env. Every value is optional.

# Port and host for the dashboard. Keep 127.0.0.1 unless you set SEATED_PASSWORD.
PORT=4310
HOST=127.0.0.1

# Where Seated keeps its SQLite file.
SEATED_DB=data/seated.db

# Base time between reads of one restaurant, in seconds. Seated reads restaurants with
# few open tables twice as often and busy ones less often, but never more than once a
# minute: the booking platforms are shared infrastructure.
POLL_SECONDS=120

# How many days ahead a watch looks when it has no end date.
HORIZON_DAYS=14

# Auto-book master switch. Off unless set to "true". Each watch must also opt in.
AUTOBOOK=false

# Protect the dashboard with HTTP basic auth (user "seated") when you host it.
SEATED_PASSWORD=

# Optional dead man's switch: a URL that Seated calls after each check (for example
# from healthchecks.io). If the calls stop, that service alerts you.
HEALTHCHECK_URL=
